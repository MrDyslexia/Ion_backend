# ─── Servidor ───────────────────────────────────────────────
PORT=3000

# ─── LLM (Ollama) ────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=512

# ─── TTS (XTTS-v2 local) ─────────────────────────────────────
# Apunta al microservicio Python corriendo en tu máquina Windows
# Endpoint esperado: POST /tts  { text: "..." }  → audio/wav
TTS_URL=http://192.168.1.87:8002

# ─── Audio ───────────────────────────────────────────────────
# true  → guarda archivos .wav en /audio/ (solo para desarrollo)
# false → no guarda WAV (recomendado en producción)
SAVE_AUDIO=false
