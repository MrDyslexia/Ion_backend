# --- Servidor ---
PORT=3000

# --- LLM (Ollama) ---
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=512

# --- TTS (XTTS-v2 local) ---
# Apunta al microservicio Python corriendo en tu maquina Windows/WSL2
# Endpoint esperado: POST /tts  { text: "..." }  -> audio/wav
TTS_URL=http://192.168.1.87:8002

# --- Busqueda web (SearXNG self-hosted) ---
# Levantar con Podman antes de iniciar ALMA:
#   podman run -d --name searxng --restart unless-stopped \
#     -p 8080:8080 -v /home/services/searxng:/etc/searxng:Z \
#     docker.io/searxng/searxng:latest
SEARXNG_URL=http://localhost:8080

# --- Audio ---
# true  -> guarda archivos .wav en /audio/ (solo para desarrollo)
# false -> no guarda WAV (recomendado en produccion)
SAVE_AUDIO=false
