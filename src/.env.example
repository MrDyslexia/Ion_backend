# =========================================================
# ALMA — Variables de configuración
# Copia este archivo como .env y ajusta los valores
# =========================================================

# --- Servidor ---
PORT=3000

# --- LLM (Ollama) ---
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=512

# --- TTS (XTTS-v2 local) ---
# Apunta al microservicio Python corriendo en tu máquina Windows/WSL2
# Endpoint esperado: POST /synthesize  { text: "..." }  -> audio/wav
TTS_URL=http://192.168.1.87:8002

# --- Búsqueda web (SearXNG self-hosted) ---
SEARXNG_URL=http://localhost:8080

# --- Audio / ASR ---
# true  -> guarda archivos .wav y .json por conversación (recomendado para pruebas)
# false -> no guarda nada (recomendado en producción)
SAVE_AUDIO=true

# Umbral RMS del noise gate (0–32767).
# El audio por debajo de este valor se descarta antes de enviarlo a Vosk.
# Subir si hay mucho ruido ambiental (ventilador, AC, TV).
# Bajar si Vosk no detecta tu voz (micrófono muy lejano o débil).
# Referencia: silencio ≈ 50–150 | voz normal ≈ 800–4000 | ruido fuerte ≈ 300–600
NOISE_GATE_THRESHOLD=400

# Umbral RMS para que el VAD (durante el 6CIT) detecte habla activa.
# Solo afecta las preguntas largas del test (cuenta atrás, meses inversos).
VAD_SPEECH_THRESHOLD=800

# Ms de silencio continuo para que el VAD cierre el turno del paciente.
# Subir si el paciente hace pausas largas al hablar (adultos mayores).
# Bajar si el sistema tarda demasiado en responder tras cada respuesta.
VAD_SILENCE_MS=1800

# Longitud mínima de una transcripción (caracteres) para procesarla.
# Transcripciones más cortas se descartan como ruido.
MIN_TRANSCRIPT_LENGTH=4

# --- Paciente por defecto (solo para desarrollo) ---
DEFAULT_PATIENT_ID=DEV-001
DEFAULT_PATIENT_NAME=Paciente de Prueba
DEFAULT_PATIENT_AGE=70
